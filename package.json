{
  "name": "game",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx server/index.ts",
    "dev:live": "concurrently -n web,live -c cyan,magenta \"npm run dev\" \"npm run dev:server\"",
    "studio": "dotnet run --project scripts/studio-host/AuroraStudio.csproj -c Release -- http://localhost:5173/",
    "build": "tsc && vite build",
    "check:server": "tsc -p server/tsconfig.json --noEmit",
    "lint": "tsc --noEmit && tsc -p server/tsconfig.json --noEmit && tsc -p tests/tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/unit.test.ts tests/integration.test.ts tests/attract.test.ts tests/autoBattle.test.ts tests/rounds.test.ts",
    "test:unit": "node --import tsx --test tests/unit.test.ts",
    "test:integration": "node --import tsx --test tests/integration.test.ts",
    "preview": "vite preview",
    "audio:generate": "node scripts/render-audio.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "dotenv": "^18.0.5",
    "pixi.js": "^8.22.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tiktok-live-connector": "^2.5.0",
    "ws": "^8.22.0"
  }
}
